PORT=8080
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
ROOM_TTL=168h
ALLOWED_ORIGINS=http://localhost:8080
WRITE_WAIT=10s
PONG_WAIT=60s
MAX_MESSAGE_BYTES=65536
MAX_ROOM_USERS=250
MAX_CONNECTIONS=2000
MAX_STROKES_PER_ROOM=5000
SNAPSHOT_CACHE_TTL=15s
SNAPSHOT_CACHE_MAX_BYTES=67108864
MAX_CONCURRENT_RESTORES=32
ENABLE_WEBSOCKET_COMPRESSION=false
